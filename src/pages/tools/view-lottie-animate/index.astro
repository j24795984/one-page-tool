---
import '../../../styles/global.css';
---

<!DOCTYPE html>
<html lang="zh-TW">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lottie Motion Inspector | MUTANG</title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    #textP {
      background:
        radial-gradient(circle at top left, rgba(49, 77, 116, 0.08), transparent 36%),
        linear-gradient(180deg, #f5f1ea 0%, #ebe7df 100%);
      color: #314d74;
    }

    .motion-shell {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(49, 77, 116, 0.12);
      background: rgba(255, 255, 255, 0.78);
      box-shadow: 0 28px 80px rgba(49, 77, 116, 0.08);
      backdrop-filter: blur(18px);
    }

    .motion-shell::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(120deg, rgba(49, 77, 116, 0.03), transparent 28%),
        linear-gradient(300deg, rgba(177, 160, 141, 0.05), transparent 30%);
      pointer-events: none;
    }

    /* Checkerboard Grid pattern for transparency inspection */
    .bg-checkers {
      background-color: #f7f6f4;
      background-image:
        linear-gradient(45deg, #e7e5e0 25%, transparent 25%),
        linear-gradient(-45deg, #e7e5e0 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, #e7e5e0 75%),
        linear-gradient(-45deg, transparent 75%, #e7e5e0 75%);
      background-size: 20px 20px;
      background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
    }

    /* Custom range input styling */
    .timeline-slider {
      -webkit-appearance: none;
      width: 100%;
      height: 8px;
      border-radius: 4px;
      background: rgba(49, 77, 116, 0.12);
      outline: none;
      transition: background 0.2s;
    }

    .timeline-slider:hover {
      background: rgba(49, 77, 116, 0.2);
    }

    .timeline-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #314d74;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
      transition: transform 0.15s ease, background-color 0.15s ease;
    }

    .timeline-slider::-webkit-slider-thumb:hover {
      transform: scale(1.2);
      background: #243a58;
    }

    .timeline-slider::-moz-range-thumb {
      width: 18px;
      height: 18px;
      border: none;
      border-radius: 50%;
      background: #314d74;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
      transition: transform 0.15s ease, background-color 0.15s ease;
    }

    .timeline-slider::-moz-range-thumb:hover {
      transform: scale(1.2);
      background: #243a58;
    }

    /* Canvas Crosshair guidelines */
    .guide-h {
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      height: 1px;
      background: rgba(239, 68, 68, 0.25);
      pointer-events: none;
      z-index: 40;
    }

    .guide-v {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 1px;
      background: rgba(239, 68, 68, 0.25);
      pointer-events: none;
      z-index: 40;
    }

    .guide-bounds {
      position: absolute;
      inset: 5%;
      border: 1px dashed rgba(239, 68, 68, 0.2);
      pointer-events: none;
      z-index: 40;
    }

    /* Custom scrollbar for logger and side panels */
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }

    .custom-scroll::-webkit-scrollbar-track {
      background: transparent;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
      background: rgba(49, 77, 116, 0.18);
      border-radius: 99px;
    }

    .custom-scroll::-webkit-scrollbar-thumb:hover {
      background: rgba(49, 77, 116, 0.3);
    }
  </style>
</head>

<body id="textP" class="pt-20">
  <!-- Standalone Top Header -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-[#ebe7df]/90 backdrop-blur-md border-b border-[#314d74]/10 px-6 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-3 no-underline hover:opacity-80 transition-opacity">
        <div class="w-8 h-8 rounded-lg bg-[#314d74] flex items-center justify-center text-white font-bold text-lg">L</div>
        <span class="font-semibold text-[#314d74] tracking-wider">LOTTIE INSPECTOR</span>
      </a>
    </div>
    <div class="text-xs text-[#8a98ab] font-mono">Astro Standalone Tool</div>
  </header>

  <main class="px-6 pb-16 pt-32 md:px-10">
    <section class="mx-auto flex w-full max-w-[1440px] flex-col gap-8 xl:flex-row">

      <!-- Control Panel Sidebar -->
      <article class="motion-shell w-full rounded-[36px] p-6 md:p-8 xl:w-[400px] xl:flex-shrink-0 flex flex-col justify-between">
        <div>
          <div class="mb-4">
            <p class="mb-1 font-enM text-xs uppercase tracking-[0.28em] text-[#8a98ab]">Lottie Debug Platform</p>
            <h1 class="font-sans text-2xl font-light leading-snug text-[#314d74]">Lottie 動畫檢測平台</h1>
          </div>

          <!-- Section 1: Folder Selection & File Selector -->
          <div class="mb-6">
            <h3 class="mb-2 font-enM text-xs uppercase tracking-[0.15em] text-[#8a98ab]">選擇 Lottie 資料夾 Select Folder</h3>
            <div class="space-y-3">
              <label class="flex flex-col items-center justify-center border-2 border-dashed border-[#314d74]/15 hover:border-[#314d74]/40 bg-white/40 hover:bg-white/60 p-6 rounded-2xl cursor-pointer transition-all duration-300 group">
                <svg class="w-8 h-8 text-[#314d74]/60 group-hover:text-[#314d74] mb-2 transition-transform duration-300 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                </svg>
                <span class="text-sm font-sans font-semibold text-[#314d74]">選擇 Lottie 目錄</span>
                <span class="text-[10px] text-gray-400 mt-1">選取包含 JSON 的資料夾</span>
                <input type="file" id="folder-picker" webkitdirectory directory multiple class="hidden" />
              </label>

              <!-- Selected Folder Info & File Dropdown -->
              <div id="folder-info" class="hidden space-y-2">
                <div class="text-[11px] text-gray-500 font-sans flex items-center justify-between">
                  <span class="truncate max-w-[200px]">已選擇: <strong id="selected-folder-name" class="text-[#314d74] font-semibold"></strong></span>
                  <span class="flex-shrink-0 text-[#314d74] bg-[#314d74]/5 px-2 py-0.5 rounded-full text-[10px]" id="folder-file-count">0 files</span>
                </div>
                <div>
                  <label class="block text-xs font-sans text-gray-500 mb-1">選擇動畫檔案 (Select Lottie File)</label>
                  <select id="lottie-file-select" class="w-full text-xs bg-white/80 border border-[#314d74]/15 rounded-lg p-2.5 text-[#314d74] outline-none focus:border-[#314d74] transition-all">
                    <option value="">-- 選擇動畫檔案 --</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- Section 2: Canvas Background & Overlay Styles -->
          <div class="mb-6">
            <h3 class="mb-2 font-enM text-xs uppercase tracking-[0.15em] text-[#8a98ab]">畫布設置 Canvas Styles</h3>

            <div class="flex items-center gap-3 mb-3">
              <span class="text-xs font-sans text-gray-500">背景 Background:</span>
              <div class="flex gap-2">
                <button type="button" data-bg="bg-checkers" class="w-6 h-6 rounded-md border border-gray-300 bg-checkers focus:ring-2 focus:ring-[#314d74] transition-all" title="Checkerboard"></button>
                <button type="button" data-bg="bg-[#314d74]" class="w-6 h-6 rounded-md border border-[#314d74]/20 bg-[#314d74] focus:ring-2 focus:ring-[#314d74] transition-all" title="Theme Blue"></button>
                <button type="button" data-bg="bg-[#b1a08d]" class="w-6 h-6 rounded-md border border-[#b1a08d]/20 bg-[#b1a08d] focus:ring-2 focus:ring-[#314d74] transition-all" title="Theme Beige"></button>
                <button type="button" data-bg="bg-white" class="w-6 h-6 rounded-md border border-gray-300 bg-white focus:ring-2 focus:ring-[#314d74] transition-all" title="Pure White"></button>
                <button type="button" data-bg="bg-black" class="w-6 h-6 rounded-md border border-gray-700 bg-black focus:ring-2 focus:ring-[#314d74] transition-all" title="Pure Black"></button>
              </div>
            </div>

            <div class="space-y-2">
              <label class="flex items-center gap-2 text-xs font-sans text-[#314d74] cursor-pointer">
                <input type="checkbox" id="toggle-guides" class="rounded text-[#314d74]">
                <span>顯示十字中心導線 (Crosshair Guides)</span>
              </label>
              <label class="flex items-center gap-2 text-xs font-sans text-[#314d74] cursor-pointer">
                <input type="checkbox" id="toggle-bounds" class="rounded text-[#314d74]">
                <span>顯示安全框邊界 (Safe-area Boundary)</span>
              </label>
            </div>
          </div>

          <!-- Section 3: Diagnostic Metrics -->
          <div class="mb-6">
            <h3 class="mb-2 font-enM text-xs uppercase tracking-[0.15em] text-[#8a98ab]">診斷數據 Diagnostic Metrics</h3>
            <div class="bg-white/50 rounded-2xl p-4 border border-[#314d74]/5 text-xs font-sans space-y-2">
              <div class="flex justify-between">
                <span class="text-gray-500">當前狀態 Play State:</span>
                <span id="metric-state" class="font-medium text-[#314d74]">Stopped</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-500">動畫總影格 Total Frames:</span>
                <span id="metric-total-frames" class="font-enN font-semibold">-</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-500">原始影格率 Target FPS:</span>
                <span id="metric-fps" class="font-enN font-semibold">-</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-500">總持續時間 Duration:</span>
                <span id="metric-duration" class="font-enN font-semibold">-</span>
              </div>
              <!-- Sync Check removed as not in split/overlay mode -->
            </div>
          </div>
        </div>

        <!-- Custom Bookmarks Panel -->
        <div class="mt-4 pt-4 border-t border-[#314d74]/10">
          <h3 class="mb-2 font-enM text-xs uppercase tracking-[0.15em] text-[#8a98ab]">自訂書籤影格 Bookmarks</h3>
          <div class="flex gap-2 mb-3">
            <input type="text" id="bookmark-label" placeholder="影格備註 Label..." class="flex-1 text-xs px-3 py-2 bg-white/80 border border-[#314d74]/15 rounded-lg outline-none focus:border-[#314d74]">
            <button type="button" id="btn-add-bookmark" class="px-3 py-2 bg-[#314d74] text-white text-xs rounded-lg hover:bg-[#243a58] transition-colors">儲存</button>
          </div>
          <div id="bookmarks-container" class="custom-scroll max-h-[140px] overflow-y-auto space-y-1.5 pr-1">
            <!-- Dynamic bookmarks will render here -->
            <p class="text-xs text-gray-400 italic font-sans text-center py-2">尚未儲存自訂影格</p>
          </div>
        </div>
      </article>

      <!-- Viewer & Timeline Section -->
      <article class="motion-shell w-full rounded-[36px] p-5 md:p-8 flex-1 flex flex-col justify-between min-h-[580px] xl:min-h-0">

        <!-- Viewport Stage -->
        <div class="relative w-full flex-1 flex items-center justify-center rounded-[24px] overflow-hidden bg-checkers transition-all duration-300" id="lottie-viewer-stage" style="min-height: 360px;">
          <!-- Guides -->
          <div id="canvas-guide-h" class="guide-h hidden"></div>
          <div id="canvas-guide-v" class="guide-v hidden"></div>
          <div id="canvas-guide-bounds" class="guide-bounds hidden"></div>

          <!-- Dynamic containers get injected here -->
          <div id="lottie-animation-host" class="w-full max-w-[800px] aspect-[960/494] relative transition-transform duration-300">
            <!-- Single Lottie host -->
            <div id="combined-host" class="w-full h-full"></div>
          </div>
        </div>

        <!-- Timeline & Controls Panel -->
        <div class="mt-6 border-t border-[#314d74]/10 pt-5">

          <!-- Timeline Slider & Frames readout -->
          <div class="flex items-center gap-4 mb-4">
            <span id="current-frame-readout" class="font-enN text-3xl font-extralight text-[#314d74] w-16 text-right leading-none">000</span>

            <div class="flex-1 relative">
              <input type="range" id="timeline-scrubber" min="0" max="100" value="0" step="1" class="timeline-slider">
              <!-- Slider Tick lines for landmarks (0, 45, 90, 135, 181) -->
              <div id="slider-landmarks" class="absolute left-0 right-0 -bottom-5 flex justify-between px-1 text-[10px] font-enN text-gray-400 select-none pointer-events-none">
                <span>0</span>
                <span>45</span>
                <span>90</span>
                <span>135</span>
                <span id="slider-max-tick">181</span>
              </div>
            </div>

            <div class="text-xs text-gray-500 font-enN w-20 text-left">
              / <span id="max-frame-readout">000</span> f
              <div id="time-readout" class="text-[10px] text-gray-400 mt-0.5">0.00s</div>
            </div>
          </div>

          <!-- Control Buttons Group -->
          <div class="flex flex-wrap items-center justify-between gap-4 mt-6">
            <div class="flex items-center gap-2">
              <!-- Play / Pause -->
              <button type="button" id="btn-play-pause" class="w-12 h-12 rounded-full bg-[#314d74] text-white flex items-center justify-center hover:bg-[#243a58] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#314d74]" title="Play / Pause">
                <svg id="play-icon" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
                <svg id="pause-icon" class="w-5 h-5 fill-current hidden" viewBox="0 0 24 24">
                  <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                </svg>
              </button>

              <!-- Stop -->
              <button type="button" id="btn-stop" class="w-10 h-10 rounded-full border border-[#314d74]/15 bg-white/80 text-[#314d74] flex items-center justify-center hover:bg-white hover:border-[#314d74]/40 transition-all focus:outline-none" title="Stop">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M6 6h12v12H6z" />
                </svg>
              </button>

              <div class="h-6 w-px bg-gray-300 mx-1"></div>

              <!-- Step Backward -->
              <button type="button" id="btn-step-prev" class="w-10 h-10 rounded-full border border-[#314d74]/15 bg-white/80 text-[#314d74] flex items-center justify-center hover:bg-white hover:border-[#314d74]/40 transition-all focus:outline-none" title="Previous Frame (Left Arrow)">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
                </svg>
              </button>

              <!-- Step Forward -->
              <button type="button" id="btn-step-next" class="w-10 h-10 rounded-full border border-[#314d74]/15 bg-white/80 text-[#314d74] flex items-center justify-center hover:bg-white hover:border-[#314d74]/40 transition-all focus:outline-none" title="Next Frame (Right Arrow)">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M6 18l8.5-6L6 6zm9-12v12h2V6z" />
                </svg>
              </button>
            </div>

            <!-- Predefined Frame Milestones -->
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-sans text-gray-400 mr-1">偵數確認:</span>
              <button type="button" data-frame-jump="0" class="px-2.5 py-1 text-xs font-enN rounded-md bg-white/80 border border-[#314d74]/10 hover:border-[#314d74]/30 hover:bg-white text-[#314d74] transition-all">0</button>
              <button type="button" data-frame-jump="30" class="px-2.5 py-1 text-xs font-enN rounded-md bg-white/80 border border-[#314d74]/10 hover:border-[#314d74]/30 hover:bg-white text-[#314d74] transition-all">30</button>
              <button type="button" data-frame-jump="60" class="px-2.5 py-1 text-xs font-enN rounded-md bg-white/80 border border-[#314d74]/10 hover:border-[#314d74]/30 hover:bg-white text-[#314d74] transition-all">60</button>
              <button type="button" data-frame-jump="90" class="px-2.5 py-1 text-xs font-enN rounded-md bg-white/80 border border-[#314d74]/10 hover:border-[#314d74]/30 hover:bg-white text-[#314d74] transition-all">90</button>
              <button type="button" data-frame-jump="135" class="px-2.5 py-1 text-xs font-enN rounded-md bg-white/80 border border-[#314d74]/10 hover:border-[#314d74]/30 hover:bg-white text-[#314d74] transition-all">135</button>
              <button type="button" id="btn-jump-max" data-frame-jump="181" class="px-2.5 py-1 text-xs font-enN rounded-md bg-white/80 border border-[#314d74]/10 hover:border-[#314d74]/30 hover:bg-white text-[#314d74] transition-all">181</button>
            </div>

            <!-- Loop & Speed Controls -->
            <div class="flex items-center gap-4">
              <!-- Loop Toggle -->
              <label class="flex items-center gap-1.5 text-xs text-[#314d74] font-sans cursor-pointer">
                <input type="checkbox" id="toggle-loop" class="rounded text-[#314d74]" checked>
                <span>循環播放 Loop</span>
              </label>

              <!-- Speed Selector -->
              <div class="flex items-center gap-1">
                <span class="text-xs text-gray-500 font-sans">倍速 Speed:</span>
                <select id="playback-speed" class="text-xs bg-white/80 border border-[#314d74]/15 rounded-lg p-1.5 text-[#314d74] outline-none">
                  <option value="0.1">0.1x</option>
                  <option value="0.25">0.25x</option>
                  <option value="0.5">0.5x</option>
                  <option value="1.0" selected>1.0x</option>
                  <option value="1.5">1.5x</option>
                  <option value="2.0">2.0x</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Console Event Logger -->
          <div class="mt-6">
            <div class="flex justify-between items-center mb-2">
              <span class="text-xs font-enM uppercase tracking-wider text-[#8a98ab]">運行紀錄 Event Console</span>
              <button type="button" id="btn-clear-log" class="text-[10px] font-sans text-gray-400 hover:text-red-500 transition-colors">清除紀錄 Clear</button>
            </div>
            <div id="console-logger" class="w-full h-24 bg-black/85 text-[11px] font-enN text-green-400 p-3 rounded-xl overflow-y-auto custom-scroll space-y-1 select-text">
              <div class="text-gray-500">[System] Initializing Lottie Motion Inspector...</div>
            </div>
          </div>

        </div>

      </article>

    </section>
  </main>

  <footer class="w-full text-center py-8 text-xs text-[#8a98ab] border-t border-[#314d74]/10 mt-12">
    &copy; 2026 Lottie Motion Inspector. All rights reserved.
  </footer>
</body>

</html>

<script>
  import lottie from 'lottie-web';

  // Lottie Inspector Logic
  (() => {
    // DOM Elements
    const folderPicker = document.getElementById('folder-picker');
    const folderInfo = document.getElementById('folder-info');
    const selectedFolderName = document.getElementById('selected-folder-name');
    const folderFileCount = document.getElementById('folder-file-count');
    const lottieFileSelect = document.getElementById('lottie-file-select');
    
    const bgButtons = document.querySelectorAll('[data-bg]');
    const toggleGuides = document.getElementById('toggle-guides');
    const toggleBounds = document.getElementById('toggle-bounds');
    const viewerStage = document.getElementById('lottie-viewer-stage');

    // Guide elements
    const guideH = document.getElementById('canvas-guide-h');
    const guideV = document.getElementById('canvas-guide-v');
    const guideBounds = document.getElementById('canvas-guide-bounds');

    // Host elements
    const combinedHost = document.getElementById('combined-host');

    // Timeline elements
    const scrubber = document.getElementById('timeline-scrubber');
    const currentFrameReadout = document.getElementById('current-frame-readout');
    const maxFrameReadout = document.getElementById('max-frame-readout');
    const timeReadout = document.getElementById('time-readout');
    const sliderMaxTick = document.getElementById('slider-max-tick');

    // Controls
    const btnPlayPause = document.getElementById('btn-play-pause');
    const playIcon = document.getElementById('play-icon');
    const pauseIcon = document.getElementById('pause-icon');
    const btnStop = document.getElementById('btn-stop');
    const btnStepPrev = document.getElementById('btn-step-prev');
    const btnStepNext = document.getElementById('btn-step-next');
    const toggleLoop = document.getElementById('toggle-loop');
    const speedSelect = document.getElementById('playback-speed');
    const frameJumpButtons = document.querySelectorAll('[data-frame-jump]');

    // Diagnostics Metrics
    const metricState = document.getElementById('metric-state');
    const metricTotalFrames = document.getElementById('metric-total-frames');
    const metricFps = document.getElementById('metric-fps');
    const metricDuration = document.getElementById('metric-duration');

    // Bookmarks elements
    const bookmarkLabelInput = document.getElementById('bookmark-label');
    const btnAddBookmark = document.getElementById('btn-add-bookmark');
    const bookmarksContainer = document.getElementById('bookmarks-container');

    // Console element
    const consoleLogger = document.getElementById('console-logger');
    const btnClearLog = document.getElementById('btn-clear-log');

    // State variables
    let selectedFolderFiles = []; // Array of File objects
    let isPlaying = false;
    let isUserScrubbing = false;
    let playSpeed = 1.0;
    let isLoopEnabled = true;

    // Lottie instances
    let animations = []; // Array of active animations
    let animationMain = null; // Combined/Main animation

    // Event Logger helper
    function logEvent(message, type = 'info') {
      const timeStr = new Date().toTimeString().split(' ')[0];
      const logDiv = document.createElement('div');

      let colorClass = 'text-green-400';
      if (type === 'warn') colorClass = 'text-yellow-300';
      if (type === 'error') colorClass = 'text-red-400';
      if (type === 'sys') colorClass = 'text-gray-400';

      logDiv.className = colorClass;
      logDiv.innerHTML = `<span class="text-gray-500">[${timeStr}]</span> ${message}`;

      consoleLogger.appendChild(logDiv);
      consoleLogger.scrollTop = consoleLogger.scrollHeight;
    }

    // Bookmarks logic
    function getStorageKey() {
      const fileIndex = lottieFileSelect ? lottieFileSelect.value : '';
      const fileName = (fileIndex !== '' && selectedFolderFiles[parseInt(fileIndex)]) ? selectedFolderFiles[parseInt(fileIndex)].name : 'default';
      return `lottie_bookmarks_${fileName}`;
    }

    function loadBookmarks() {
      const key = getStorageKey();
      const raw = localStorage.getItem(key);
      let list = [];
      try {
        if (raw) list = JSON.parse(raw);
      } catch (e) {
        logEvent('讀取書籤失敗，格式有誤。', 'error');
      }
      return list;
    }

    function saveBookmarks(list) {
      const key = getStorageKey();
      localStorage.setItem(key, JSON.stringify(list));
      renderBookmarks();
    }

    function renderBookmarks() {
      const list = loadBookmarks();
      bookmarksContainer.innerHTML = '';

      if (list.length === 0) {
        bookmarksContainer.innerHTML = '<p class="text-xs text-gray-400 italic font-sans text-center py-2">尚未儲存自訂影格</p>';
        return;
      }

      list.forEach((bm, index) => {
        const itemDiv = document.createElement('div');
        itemDiv.className = 'flex items-center justify-between gap-2 bg-white/60 p-2 rounded-lg border border-[#314d74]/5 hover:bg-white transition-all';

        itemDiv.innerHTML = `
          <button type="button" class="flex-1 text-left flex items-baseline gap-2 cursor-pointer focus:outline-none">
            <span class="font-enN text-xs font-semibold text-[#314d74]">F-${String(bm.frame).padStart(3, '0')}</span>
            <span class="text-[11px] text-gray-500 font-sans truncate max-w-[140px]" title="${bm.label}">${bm.label || '未具名'}</span>
          </button>
          <button type="button" class="text-gray-400 hover:text-red-500 transition-colors text-sm px-1 leading-none cursor-pointer focus:outline-none" title="刪除書籤">&times;</button>
        `;

        // Click to jump
        itemDiv.querySelector('button:first-child').addEventListener('click', () => {
          seekToFrame(bm.frame);
          logEvent(`跳轉到書籤影格: ${bm.frame} (${bm.label || '無備註'})`);
        });

        // Click to delete
        itemDiv.querySelector('button:last-child').addEventListener('click', (e) => {
          e.stopPropagation();
          const newList = list.filter((_, i) => i !== index);
          saveBookmarks(newList);
          logEvent(`已刪除書籤影格 ${bm.frame}`);
        });

        bookmarksContainer.appendChild(itemDiv);
      });
    }

    // Background Canvas color selector
    bgButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Remove existing bg classes
        viewerStage.className = viewerStage.className.replace(/\bbg-\S+/g, '');
        // Add selected bg class
        const targetBg = btn.getAttribute('data-bg');
        viewerStage.classList.add(targetBg);
        logEvent(`更改背景色為: ${targetBg}`);
      });
    });

    // Toggle Guides
    toggleGuides.addEventListener('change', (e) => {
      const show = e.target.checked;
      guideH.classList.toggle('hidden', !show);
      guideV.classList.toggle('hidden', !show);
      logEvent(`${show ? '顯示' : '隱藏'} 十字中心導線`);
    });

    toggleBounds.addEventListener('change', (e) => {
      const show = e.target.checked;
      guideBounds.classList.toggle('hidden', !show);
      logEvent(`${show ? '顯示' : '隱藏'} 安全框邊界`);
    });

    // Clear animations in container hosts
    function destoryCurrentAnimations() {
      animations.forEach(anim => {
        try {
          anim.destroy();
        } catch (e) {
          console.error(e);
        }
      });
      animations = [];
      animationMain = null;

      // Clear HTML containers content
      combinedHost.innerHTML = '';
    }

    // Load selected file
    function loadLottieFile(file) {
      destoryCurrentAnimations();
      isPlaying = false;
      updatePlayPauseButton();

      logEvent(`開始載入檔案: ${file.name}`, 'sys');

      const reader = new FileReader();
      reader.onload = function(event) {
        try {
          const animationData = JSON.parse(event.target.result);
          
          if (!animationData.v || typeof animationData.fr === 'undefined') {
            logEvent(`檔案 ${file.name} 似乎不是有效的 Lottie JSON。`, 'warn');
          }

          animationMain = lottie.loadAnimation({
            container: combinedHost,
            renderer: 'svg',
            loop: isLoopEnabled,
            autoplay: false,
            animationData: animationData
          });

          animations.push(animationMain);

          animationMain.addEventListener('DOMLoaded', () => {
            const total = Math.floor(animationMain.totalFrames);
            const fps = animationMain.frameRate;
            const dur = (total / fps).toFixed(2);

            logEvent(`載入完成! 總影格: ${total}f, 影格率: ${fps}fps, 時長: ${dur}s`);

            // Update UI metrics
            metricTotalFrames.textContent = total;
            metricFps.textContent = fps;
            metricDuration.textContent = `${dur}s`;
            metricState.textContent = 'Ready';

            scrubber.max = total - 1;
            scrubber.value = 0;
            sliderMaxTick.textContent = total - 1;
            maxFrameReadout.textContent = String(total - 1).padStart(3, '0');

            // Update pre-defined jump button limits
            document.getElementById('btn-jump-max').setAttribute('data-frame-jump', total - 1);
            document.getElementById('btn-jump-max').textContent = total - 1;

            // Initialize state
            seekToFrame(0);
          });

          animationMain.addEventListener('enterFrame', () => {
            if (!isUserScrubbing) {
              updateTimelineUI(animationMain.currentFrame);
            }
          });

          animationMain.addEventListener('complete', () => {
            if (!isLoopEnabled) {
              isPlaying = false;
              updatePlayPauseButton();
              metricState.textContent = 'Finished';
              logEvent('播放完畢');
            }
          });

          renderBookmarks();

        } catch (err) {
          logEvent(`解析 JSON 失敗: ${err.message}`, 'error');
        }
      };

      reader.onerror = function() {
        logEvent(`讀取檔案失敗: ${file.name}`, 'error');
      };

      reader.readAsText(file);
    }

    // Update timeline elements (Readout numbers, scrubber value, time text)
    function updateTimelineUI(currentFrame) {
      const frameInt = Math.round(currentFrame);
      currentFrameReadout.textContent = String(frameInt).padStart(3, '0');
      scrubber.value = frameInt;

      // Compute time based on FPS
      const fps = animationMain ? animationMain.frameRate : 30;
      const currentTimeSec = (frameInt / fps).toFixed(2);
      const maxFrames = scrubber.max;
      const totalTimeSec = (maxFrames / fps).toFixed(2);
      timeReadout.textContent = `${currentTimeSec}s / ${totalTimeSec}s`;
    }

    // Playback control functions
    function togglePlayPause() {
      if (animations.length === 0) return;

      if (isPlaying) {
        // Pause
        animations.forEach(anim => anim.pause());
        isPlaying = false;
        metricState.textContent = 'Paused';
        logEvent('動畫暫停');
      } else {
        // Play
        animations.forEach(anim => {
          anim.setSpeed(playSpeed);
          anim.play();
        });
        isPlaying = true;
        metricState.textContent = 'Playing';
        logEvent(`播放動畫 (速度: ${playSpeed}x)`);
      }
      updatePlayPauseButton();
    }

    // Update play pause buttons
    function updatePlayPauseButton() {
      if (isPlaying) {
        playIcon.classList.add('hidden');
        pauseIcon.classList.remove('hidden');
      } else {
        playIcon.classList.remove('hidden');
        pauseIcon.classList.add('hidden');
      }
    }

    function stopAnimation() {
      if (animations.length === 0) return;
      animations.forEach(anim => {
        anim.pause();
        anim.goToAndStop(0, true);
      });
      isPlaying = false;
      updatePlayPauseButton();
      metricState.textContent = 'Stopped';
      updateTimelineUI(0);
      logEvent('停止並重設至起點');
    }

    // Seek to specific frame
    function seekToFrame(frame) {
      if (animations.length === 0) return;

      animations.forEach(anim => {
        const max = anim.totalFrames - 1;
        const target = Math.min(Math.max(0, frame), max);
        anim.goToAndStop(target, true);
      });

      updateTimelineUI(frame);
    }

    function stepFrame(dir) {
      if (animations.length === 0) return;

      // Pause first
      if (isPlaying) {
        animations.forEach(anim => anim.pause());
        isPlaying = false;
        updatePlayPauseButton();
        metricState.textContent = 'Paused';
      }

      // Get current frame
      const current = parseFloat(scrubber.value);
      const target = current + dir;
      seekToFrame(target);
      logEvent(`單格步進: ${dir > 0 ? '+' : ''}${dir} 影格 -> ${scrubber.value}`);
    }

    // Folder select listener
    folderPicker.addEventListener('change', (e) => {
      const files = Array.from(e.target.files);
      if (files.length === 0) return;

      // Extract the root folder name from webkitRelativePath
      const firstPath = files[0].webkitRelativePath;
      const folderName = firstPath ? firstPath.split('/')[0] : 'Selected Folder';
      selectedFolderName.textContent = folderName;

      // Filter JSON files at "this level" only (not in subfolders)
      selectedFolderFiles = files.filter(file => {
        const isJson = file.name.toLowerCase().endsWith('.json');
        if (!isJson) return false;

        const path = file.webkitRelativePath || '';
        const normalizedPath = path.replace(/\\/g, '/');
        const parts = normalizedPath.split('/');
        
        return parts.length === 2;
      });

      // Update dropdown options
      lottieFileSelect.innerHTML = '<option value="">-- 選擇動畫檔案 --</option>';
      selectedFolderFiles.forEach((file, index) => {
        const option = document.createElement('option');
        option.value = index;
        option.textContent = file.name;
        lottieFileSelect.appendChild(option);
      });

      folderFileCount.textContent = `${selectedFolderFiles.length} 個 JSON`;
      folderInfo.classList.remove('hidden');

      logEvent(`讀取資料夾完成，找到 ${selectedFolderFiles.length} 個本層 JSON 檔案`, 'sys');

      // Auto select the first JSON file if available
      if (selectedFolderFiles.length > 0) {
        lottieFileSelect.value = '0';
        lottieFileSelect.dispatchEvent(new Event('change'));
      } else {
        destoryCurrentAnimations();
        metricState.textContent = 'Stopped';
      }
    });

    // File selection dropdown change
    lottieFileSelect.addEventListener('change', (e) => {
      const fileIndex = e.target.value;
      if (fileIndex !== '') {
        const file = selectedFolderFiles[parseInt(fileIndex)];
        loadLottieFile(file);
      } else {
        destoryCurrentAnimations();
        metricState.textContent = 'Stopped';
        logEvent('未選取檔案');
      }
    });

    // Event listeners for timeline range scrubber
    scrubber.addEventListener('input', () => {
      isUserScrubbing = true;
      const targetFrame = parseInt(scrubber.value);
      seekToFrame(targetFrame);
    });

    scrubber.addEventListener('change', () => {
      isUserScrubbing = false;
      const targetFrame = parseInt(scrubber.value);
      seekToFrame(targetFrame);
      logEvent(`拖曳影格定位至: ${targetFrame}`);
    });

    // Control Buttons binding
    btnPlayPause.addEventListener('click', togglePlayPause);
    btnStop.addEventListener('click', stopAnimation);
    btnStepPrev.addEventListener('click', () => stepFrame(-1));
    btnStepNext.addEventListener('click', () => stepFrame(1));

    // Predefined milestones jumping
    frameJumpButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const frame = parseInt(btn.getAttribute('data-frame-jump'));
        seekToFrame(frame);
        logEvent(`定位至里程碑影格: ${frame}`);
      });
    });

    // Playback loop toggle
    toggleLoop.addEventListener('change', (e) => {
      isLoopEnabled = e.target.checked;
      animations.forEach(anim => {
        anim.loop = isLoopEnabled;
      });
      logEvent(`循環播放模式: ${isLoopEnabled ? '開啟' : '關閉'}`);
    });

    // Playback Speed selector
    speedSelect.addEventListener('change', (e) => {
      playSpeed = parseFloat(e.target.value);
      animations.forEach(anim => {
        anim.setSpeed(playSpeed);
      });
      logEvent(`播放速度設定為: ${playSpeed}x`);
    });

    // Bookmarks Operations
    btnAddBookmark.addEventListener('click', () => {
      const fileIndex = lottieFileSelect.value;
      if (fileIndex === '') {
        logEvent('請先選取動畫檔案再新增書籤', 'warn');
        return;
      }

      const label = bookmarkLabelInput.value.trim();
      const currentF = parseInt(scrubber.value);

      const list = loadBookmarks();
      const exists = list.some(bm => bm.frame === currentF);
      if (exists) {
        logEvent(`影格 ${currentF} 已存在書籤中`, 'warn');
        return;
      }

      list.push({
        frame: currentF,
        label: label
      });
      list.sort((a, b) => a.frame - b.frame);
      saveBookmarks(list);

      bookmarkLabelInput.value = '';
      logEvent(`已儲存書籤影格 ${currentF}: ${label || '未具名'}`);
    });

    bookmarkLabelInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        btnAddBookmark.click();
      }
    });

    // Keyboard Hotkeys
    document.addEventListener('keydown', (e) => {
      if (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'SELECT') {
        return;
      }

      if (e.key === ' ') {
        e.preventDefault();
        togglePlayPause();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        stepFrame(1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        stepFrame(-1);
      } else if (e.key === 'r' || e.key === 'R') {
        e.preventDefault();
        stopAnimation();
      }
    });

    // Clear console log
    btnClearLog.addEventListener('click', () => {
      consoleLogger.innerHTML = '<div class="text-gray-500">[System] Console logs cleared.</div>';
    });

    // Initial message
    logEvent('請先選取包含 Lottie JSON 檔案的資料夾以開始。', 'sys');
  })();
</script>
