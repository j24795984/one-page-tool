---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createUiShowcaseItems } from '../data/ui-showcase.js';
import { getTools } from '../data/tools.js';
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const uiItems = createUiShowcaseItems(baseUrl);
const tools = getTools(baseUrl);
const categories = [...new Set(uiItems.flatMap(item => item.effects))];
---
<BaseLayout title="個人前端資源庫">
  <main class="mx-auto w-full max-w-7xl px-5 py-12 md:px-8">
    <p class="text-sm tracking-widest">ONE PAGE TOOL</p>
    <h1 class="mt-4 text-4xl font-medium">個人前端資源庫</h1>
    <p class="mt-4 text-[#65758b]">整理介面效果與實用工具，找到適合的實作，再帶進下一個專案。</p>
    <div class="my-10 grid gap-5 md:grid-cols-2">
      <a href={baseUrl + 'ui/'} class="rounded-2xl border border-[#314d74]/20 bg-white/60 p-7">
        <h2 class="text-2xl">UI 庫</h2>
        <p class="mt-3">{uiItems.length} 個介面與互動效果，依用途分類、搜尋與預覽。</p>
      </a>
      <a href={baseUrl + 'tools/'} class="rounded-2xl border border-[#314d74]/20 bg-white/60 p-7">
        <h2 class="text-2xl">小工具</h2>
        <p class="mt-3">{tools.length} 個工具，快速進行動畫預覽與日常開發操作。</p>
      </a>
    </div>
    <section aria-labelledby="category-title">
      <h2 id="category-title" class="text-xl">依用途瀏覽</h2>
      <ul class="mt-4 flex flex-wrap gap-3">
        {categories.map(category => <li><a class="inline-block rounded-full border border-[#314d74]/20 px-4 py-2" href={baseUrl + 'ui/?effects=' + encodeURIComponent(category)}>{category}</a></li>)}
      </ul>
    </section>
  </main>
</BaseLayout>
