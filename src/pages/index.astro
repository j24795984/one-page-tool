---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>One-Page Tools Portal | MUTANG</title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    body {
      background:
        radial-gradient(circle at top left, rgba(49, 77, 116, 0.08), transparent 36%),
        radial-gradient(circle at bottom right, rgba(177, 160, 141, 0.06), transparent 40%),
        linear-gradient(180deg, #f5f1ea 0%, #ebe7df 100%);
      color: #314d74;
      font-family: 'Inter', sans-serif;
    }
    .hero-glass {
      background: rgba(255, 255, 255, 0.45);
      border: 1px solid rgba(49, 77, 116, 0.08);
      box-shadow: 0 40px 100px rgba(49, 77, 116, 0.05);
      backdrop-filter: blur(20px);
    }
    .tool-card {
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid rgba(49, 77, 116, 0.08);
      box-shadow: 0 20px 50px rgba(49, 77, 116, 0.04);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .tool-card:hover {
      transform: translateY(-4px);
      background: rgba(255, 255, 255, 0.95);
      border-color: rgba(49, 77, 116, 0.25);
      box-shadow: 0 30px 60px rgba(49, 77, 116, 0.08);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between pt-16">

  <!-- Top Navbar -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-[#ebe7df]/90 backdrop-blur-md border-b border-[#314d74]/10 px-6 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-[#314d74] flex items-center justify-center text-white font-bold text-lg">M</div>
      <span class="font-semibold text-[#314d74] tracking-wider">MUTANG TOOLS</span>
    </div>
    <div class="text-xs text-[#8a98ab] font-mono">Astro Portal</div>
  </header>

  <main class="flex-1 flex items-center justify-center px-6 py-12">
    <div class="w-full max-w-4xl">
      <!-- Welcome Hero -->
      <div class="hero-glass rounded-[40px] p-8 md:p-12 text-center mb-12">
        <p class="font-semibold text-xs uppercase tracking-[0.3em] text-[#8a98ab] mb-2">Workspace Hub</p>
        <h1 class="text-3xl md:text-4xl font-light text-[#314d74] leading-tight mb-4">單頁式開發輔助工具箱</h1>
        <p class="text-sm text-gray-500 max-w-lg mx-auto leading-relaxed">
          這裡是 MUTANG 團隊的網頁前端開發輔助工具平台。所有工具皆為純前端、無伺服器依賴，安全且快速。
        </p>
      </div>

      <!-- Tools Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Tool Card 1: Lottie Inspector -->
        <a href="/tools/view-lottie-animate/" class="tool-card rounded-[32px] p-8 flex flex-col justify-between group no-underline text-[#314d74]">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[#314d74]/5 flex items-center justify-center text-[#314d74] mb-6 group-hover:bg-[#314d74] group-hover:text-white transition-colors duration-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h2 class="text-xl font-medium mb-2">Lottie 動畫檢測平台</h2>
            <p class="text-xs text-gray-500 leading-relaxed mb-8">
              選擇本地專案資料夾，自動讀取並播放首層 Lottie JSON 動畫。支援影格精確控制、播放速度調節、中心十字導線與自訂影格書籤。
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-semibold tracking-wider text-[#314d74]">
            開始使用
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>

        <!-- Placeholder for next tool -->
        <div class="tool-card rounded-[32px] p-8 flex flex-col justify-between border-dashed opacity-60">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-gray-100 flex items-center justify-center text-gray-400 mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h2 class="text-xl font-medium text-gray-400 mb-2">新增其他輔助工具</h2>
            <p class="text-xs text-gray-400 leading-relaxed mb-8">
              未來若有其他單頁式輔助工具（例如圖檔壓縮、SVG 最佳化、JSON 排版等），皆可直接在此專案中新增對應路由與元件。
            </p>
          </div>
          <div class="text-xs font-semibold text-gray-400">
            敬請期待
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer class="w-full text-center py-8 text-xs text-[#8a98ab] border-t border-[#314d74]/10">
    &copy; 2026 MUTANG Tools Portal. All rights reserved.
  </footer>
</body>
</html>
