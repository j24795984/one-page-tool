---
import TopMenu from '../../components/TopMenu.vue';
import UiShowcaseDirectory from '../../components/UiShowcaseDirectory.vue';
import { createUiShowcaseItems } from '../../data/ui-showcase.js';
import '../../styles/global.css';

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const items = createUiShowcaseItems(baseUrl);
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UI 展示 | One Page Tool</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen bg-[#f5f1ea] font-['Inter',sans-serif] text-[#314d74]">
  <TopMenu baseUrl={baseUrl} />
  <UiShowcaseDirectory client:load items={items} />
</body>
</html>
