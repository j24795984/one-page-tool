---
import ContentDirectory from '../../components/ContentDirectory.vue';
import TopMenu from '../../components/TopMenu.vue';
import '../../styles/global.css';

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const items = [
  {
    title: 'Page Link Highlight',
    category: '導覽'
  },
  {
    title: 'Parallax',
    category: '視差'
  },
  {
    title: 'Text Fade',
    category: '文字'
  },
  {
    title: 'Object Fade Active',
    category: '物件',
    href: `${baseUrl}js-effects/object-fade-active/`
  }
];
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JS 效果 | One Page Tool</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen bg-[#f5f1ea] font-['Inter',sans-serif] text-[#314d74]">
  <TopMenu baseUrl={baseUrl} />
  <ContentDirectory
    client:load
    title="JS 效果"
    items={items}
  />
</body>
</html>
