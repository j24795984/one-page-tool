---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UiShowcaseDirectory from '../../components/UiShowcaseDirectory.vue';
import { createUiShowcaseItems } from '../../data/ui-showcase.js';
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const items = createUiShowcaseItems(baseUrl).filter((item) => item.execution);
---
<BaseLayout title="UI 庫・版面與互動範例">
  <UiShowcaseDirectory client:load items={items} />
</BaseLayout>
