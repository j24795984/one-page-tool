---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PatternDetail from '../../../components/PatternDetail.vue';
import { createUiShowcaseItems } from '../../../data/ui-showcase.js';
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const item = createUiShowcaseItems(baseUrl).find(item => item.id === 'dramatic-diagonal-carousel');
---
<BaseLayout title={item.title} showNavigation={false}>
 <PatternDetail client:load item={item} baseUrl={baseUrl} />
</BaseLayout>
