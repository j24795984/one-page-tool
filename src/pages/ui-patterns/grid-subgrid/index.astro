---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PatternDetail from '../../../components/PatternDetail.vue';
import { getPatternDetails } from '../../../data/ui-patterns.js';
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const item = {
 ...getPatternDetails(baseUrl).find(item => item.href === `${baseUrl}ui-patterns/grid-subgrid/`),
 id: 'grid-subgrid',
 title: 'Subgrid Alignment',
};
---
<BaseLayout title={item.title} showNavigation={false}>
 <PatternDetail client:load item={item} baseUrl={baseUrl} />
</BaseLayout>
